# ============================================================
# CSCA 环境变量模板（复制为 .env 后按环境填写；.env 已被 .gitignore 排除，勿提交）
# 变量名与 cs-api/src/main/resources/application.yml 的 ${} 占位一一对应
# 敏感值（密钥/PEM/token）不入仓库、不入文档（开发纪律 9；《11》§7）
# ============================================================

# ---- 数据库（ECS 原生 PostgreSQL；本地/Testcontainers 由 @ServiceConnection 覆盖）----
CS_DB_URL=jdbc:postgresql://localhost:5432/cs_dev
CS_DB_USER=cs_dev
CS_DB_PASSWORD=change-me

# ---- Redis Stack ----
CS_REDIS_HOST=localhost
CS_REDIS_PORT=6379

# ---- Casdoor 身份（坐席/服务/管理员；INF-2 已核验 2026-09-20）----
# issuer/JWKS 以 OIDC discovery (/.well-known/openid-configuration) 为准；
# 注意 JWKS 端点无 .json 后缀（带后缀返回空 keys，坑#19）
# 私有部署地址不入仓库——占位域名仅示意，真实值经本地 .env / 部署环境注入
CS_AUTH_CASDOOR_ISSUER=https://casdoor.example.com
CS_AUTH_CASDOOR_JWKS=https://casdoor.example.com/.well-known/jwks
# 与 JWKS 二选一（PEM 模式，离线/测试场景；两者均空则 Casdoor issuer 不启用）
#CS_AUTH_CASDOOR_PEM=

# ---- 平台自签访客令牌（RS256 密钥对）----
# 生产必须注入固定密钥；未配置时自动生成临时密钥（仅限 dev/sit，启动 WARN）
#CS_AUTH_VISITOR_ISSUER=urn:csca:visitor
#CS_AUTH_VISITOR_PUB_PEM=
#CS_AUTH_VISITOR_PRIV_PEM=

# ---- 渠道与运行形态 ----
CS_TURN_ENGINE=echo                    # M0批4 起可切 orchestration
CS_WEBCHAT_APP_KEY=change-me
CS_WEBCHAT_APP_SECRET=change-me
CS_WEBCHAT_TENANT=csca_tenant_001      # 与 Casdoor 组织（租户）对齐
CS_LIMIT_VISITOR_RPM=20
CS_LIMIT_VISITOR_RPD=200

# ---- 模型接入（M0批4 起使用，OpenAI 兼容端点；变量名以 M0批4 落地为准）----
#CS_AI_BASE_URL=
#CS_AI_API_KEY=
#CS_AI_MODEL=
