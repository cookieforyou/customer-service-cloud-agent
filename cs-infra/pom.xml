<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.enterprise</groupId>
    <artifactId>cs-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>cs-infra</artifactId>
  <name>CSCA :: infra</name>
  <description>技术基础设施适配：PG 连接与 Flyway 迁移（唯一迁移落位，上下文前缀命名）、存储客户端、外部系统客户端、观测装配</description>

  <dependencies>
    <!-- 迁移唯一落位（M0批2，《12》§2 落位约定）：单历史表，文件名 V{n}__<上下文>_<主题>.sql -->
    <!-- Flyway 10+ 数据库模块须显式声明（缺失即 "Unsupported Database: PostgreSQL" 启动失败，Boot #49012 / 姊妹项目实证） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Redis（Redisson，版本根 POM 钉板 4.6.1——姊妹项目 Boot 4.1 实证同款，M0批3 幂等/限流启用） -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>
