<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.enterprise</groupId>
    <artifactId>cs-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>cs-channel</artifactId>
  <name>CSCA :: channel</name>
  <description>渠道接入——ChannelAdapter SPI、webchat 适配器、SSE 帧协议 v1、幂等与限流</description>

  <dependencies>
    <dependency>
      <groupId>com.enterprise</groupId>
      <artifactId>cs-commons</artifactId>
    </dependency>
    <dependency>
      <groupId>com.enterprise</groupId>
      <artifactId>cs-infra</artifactId>
    </dependency>
    <dependency>
      <groupId>com.enterprise</groupId>
      <artifactId>cs-conversation</artifactId>
    </dependency>
    <!-- M0批4：orchestration 轮次引擎经本模块适配器接入（ChatTurnPort 实现，条件装配切换 echo 桩） -->
    <dependency>
      <groupId>com.enterprise</groupId>
      <artifactId>cs-orchestration</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Flux/SSE（MVC 响应式返回，V-03 实证点） -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
    </dependency>
    <!-- Jwt 类型（@AuthenticationPrincipal）与 Nimbus（访客令牌签发） -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
